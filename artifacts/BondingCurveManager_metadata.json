		"devdoc": {
			"details": "Manages bonding curve tokens, allowing creation, buying, selling, and liquidity management.",
			"kind": "dev",
			"methods": {
				"addLP(address)": {
					"details": "Manually adds liquidity for a specified token. Can only be called by the contract owner. ",
					"params": {
						"tokenAddress": "The address of the token to add liquidity for. To be used in situations where the bond owner wants to shutdown and  ensure tokens are safely moved to DEX."
					}
				},
				"buy(address)": {
					"params": {
						"tokenAddress": "The address of the token to buy."
					}
				},
				"calculateCurvedBuyReturn(address,uint256)": {
					"params": {
						"ethAmount": "The amount of ETH to spend.",
						"tokenAddress": "The address of the token."
					},
					"returns": {
						"_0": "The number of tokens that can be purchased."
					}
				},
				"calculateCurvedSellReturn(address,uint256)": {
					"params": {
						"tokenAddress": "The address of the token.",
						"tokenAmount": "The amount of tokens to sell."
					},
					"returns": {
						"_0": "The amount of ETH that will be returned after fees."
					}
				},
				"constructor": {
					"details": "Constructor initializes the contract with the Uniswap router, BancorFormula1 address, and fee recipient.",
					"params": {
						"_bancorFormula": "Address of the deployed BancorFormula1 contract.",
						"_feeRecipient": "Address to receive the fees.",
						"_uniRouter": "Address of the Uniswap V2 Router."
					}
				},
				"create(string,string)": {
					"params": {
						"name": "The name of the new token.",
						"symbol": "The symbol of the new token."
					}
				},
				"getCurrentTokenPrice(address)": {
					"params": {
						"tokenAddress": "The address of the token."
					},
					"returns": {
						"_0": "The current price of the token in ETH."
					}
				},
				"getMarketCap(address)": {
					"params": {
						"tokenAddress": "The address of the token."
					},
					"returns": {
						"_0": "The market capitalization of the token in ETH."
					}
				},
				"getTokenEthBalance(address)": {
					"params": {
						"tokenAddress": "The address of the token."
					},
					"returns": {
						"_0": "The ETH balance of the token pool."
					}
				},
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"sell(address,uint256)": {
					"params": {
						"tokenAddress": "The address of the token to sell.",
						"tokenAmount": "The amount of tokens to sell."
					}
				},
				"setFeeRecipient(address)": {
					"params": {
						"_newRecipient": "The new address to receive fees."
					}
				},
				"setLpFeePercentage(uint256)": {
					"params": {
						"_lpFeePercentage": "The new LP fee percentage in WAD (must not exceed 5%)."
					}
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				}
			},
			"title": "BondingCurveManager",
			"version": 1
		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"buy(address)": {
					"notice": "Buys tokens for a specified token address."
				},
				"calculateCurvedBuyReturn(address,uint256)": {
					"notice": "Calculates the number of tokens that can be purchased for a given amount of ETH."
				},
				"calculateCurvedSellReturn(address,uint256)": {
					"notice": "Calculates the amount of ETH that will be returned for selling a given amount of tokens."
				},
				"create(string,string)": {
					"notice": "Creates a new bonding curve token."
				},
				"getCurrentTokenPrice(address)": {
					"notice": "Retrieves the current price of a specific token."
				},
				"getMarketCap(address)": {
					"notice": "Calculates the market capitalization of a specific token."
				},
				"getTokenEthBalance(address)": {
					"notice": "Retrieves the ETH balance for a specific token."
				},
				"sell(address,uint256)": {
					"notice": "Sells tokens for a specified token address."
				},
				"setFeeRecipient(address)": {
					"notice": "Updates the fee recipient address."
				},
				"setLpFeePercentage(uint256)": {
					"notice": "Sets the LP fee percentage."
				}
			},
			"version": 1
		}
