					"returns": {
						"k": "The number of tokens that must be burned to receive `p` collateral."
					}
				},
				"computeMintingAmountFromPrice(uint256,uint256,uint256)": {
					"params": {
						"b": "The current collateral balance in the bonding curve.",
						"p": "The amount of collateral provided.",
						"supply": "The current total supply of the token."
					},
					"returns": {
						"k": "The number of tokens that can be minted with `p` collateral."
					}
				},
				"computePriceForMinting(uint256,uint256,uint256)": {
					"params": {
						"b": "The current collateral balance in the bonding curve.",
						"k": "The number of tokens to mint.",
						"supply": "The current total supply of the token."
					},
					"returns": {
						"p": "The price (in collateral) required to mint `k` tokens."
					}
				},
				"computeRefundForBurning(uint256,uint256,uint256)": {
					"params": {
						"b": "The current collateral balance in the bonding curve.",
						"k": "The number of tokens to burn.",
						"supply": "The current total supply of the token."
					},
					"returns": {
						"p": "The amount of collateral refunded for burning `k` tokens."
					}
				}
